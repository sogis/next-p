# WMS query strings consumed by the future Maven integration tests.
# The short request avoids map rendering. The heavy request renders the fixed
# world grid at a high, but CI-safe, resolution.
SHORT_WMS_QUERY=SERVICE=WMS&VERSION=1.3.0&REQUEST=GetCapabilities
HEAVY_WMS_QUERY=SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap&LAYERS=fifo_grid&STYLES=&CRS=EPSG:4326&BBOX=-180,-90,180,90&WIDTH=3072&HEIGHT=3072&FORMAT=image/png&TRANSPARENT=FALSE
